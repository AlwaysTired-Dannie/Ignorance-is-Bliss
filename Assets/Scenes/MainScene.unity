--- !u!114 &809765682
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 809765680}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6ee4ca3529976fc4481420ba931b139c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textMessages:
  - textMessage: '-'
    date: 25 April 2106
    parentObject: {fileID: 1370269807}
    prefabText: {fileID: 8710931669128126116, guid: a36e0cc0328944f4182fb3054bdc66e8, type: 3}
  - textMessage: Do you still have the books I gave you?
    date: 25 April 2106
    parentObject: {fileID: 1370269807}
    prefabText: {fileID: 8710931669128126116, guid: 0cc92655e1478a848979f31afc5ebc5f, type: 3}
  - textMessage: yeah, why?
    date: 25 April 2106
    parentObject: {fileID: 1370269807}
    prefabText: {fileID: 8710931669128126116, guid: f2c2bd5bc8bc1bb4ea220915cdf2795f, type: 3}
  - textMessage: I'm looking for one. It's called No Longer Human.
    date: 25 April 2106
    parentObject: {fileID: 1370269807}
    prefabText: {fileID: 8710931669128126116, guid: 0cc92655e1478a848979f31afc5ebc5f, type: 3}
  - textMessage: sounds cheerful
    date: 25 April 2106
    parentObject: {fileID: 1370269807}
    prefabText: {fileID: 8710931669128126116, guid: f2c2bd5bc8bc1bb4ea220915cdf2795f, type: 3}
  - textMessage: It's pink, and has a silhouette on the cover. I want to read it
      again.
    date: 25 April 2106
    parentObject: {fileID: 1370269807}
    prefabText: {fileID: 8710931669128126116, guid: 0cc92655e1478a848979f31afc5ebc5f, type: 3}
  - textMessage: just order another copy
    date: 25 April 2106
    parentObject: {fileID: 1370269807}
    prefabText: {fileID: 8710931669128126116, guid: f2c2bd5bc8bc1bb4ea220915cdf2795f, type: 3}
  - textMessage: The one I gave you has *history*.
    date: 25 April 2106
    parentObject: {fileID: 1370269807}
    prefabText: {fileID: 8710931669128126116, guid: 0cc92655e1478a848979f31afc5ebc5f, type: 3}
  - textMessage: i'll see if i can find it
    date: 25 April 2106
    parentObject: {fileID: 1370269807}
    prefabText: {fileID: 8710931669128126116, guid: f2c2bd5bc8bc1bb4ea220915cdf2795f, type: 3}
  - textMessage: Just have a look, please?
    date: 25 April 2106
    parentObject: {fileID: 1370269807}
    prefabText: {fileID: 8710931669128126116, guid: 0cc92655e1478a848979f31afc5ebc5f, type: 3}
  - textMessage: i'll see if i can find it
    date: 25 April 2106
    parentObject: {fileID: 1370269807}
    prefabText: {fileID: 8710931669128126116, guid: f2c2bd5bc8bc1bb4ea220915cdf2795f, type: 3}
